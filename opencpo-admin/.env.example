# ── Application ────────────────────────────────────────────────────────────────
APP_TITLE=OCPP Admin

# ── Network ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080

# ── OCPP Core API ──────────────────────────────────────────────────────────────
# URL of the OCPP Core REST API (e.g. your ocpp-core service)
OCPP_CORE_API=http://localhost:8000
# API key sent to the core as X-API-Key (required unless JWT_SECRET is set)
CORE_API_KEY=change-me

# ── Auth ───────────────────────────────────────────────────────────────────────
# Secret used to verify admin session JWTs. MUST match the core's signing secret
# (compose sets it to MANAGEMENT_API_KEY). The app refuses to start if both
# JWT_SECRET and CORE_API_KEY are empty.
JWT_SECRET=change-me
# Mark the session cookie Secure. Default: true when PUBLIC_URL starts with https.
COOKIE_SECURE=false

# ── PKI ────────────────────────────────────────────────────────────────────────
# Directory containing root-ca.crt and users/ sub-directory
# Default: ../ocpp-core/data/pki (relative to this project)
PKI_DATA_DIR=../ocpp-core/data/pki
