[Unit]
Description=OpenCPO pull-based auto-deploy
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/scripts/deploy.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
